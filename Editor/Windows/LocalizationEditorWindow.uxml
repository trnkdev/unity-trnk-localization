<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="True">
    <ui:VisualElement name="root" class="root">

        <!-- Top bar: settings asset selector and quick actions -->
        <ui:VisualElement name="topBar" class="top-bar">
            <ui:Label text="Settings:" class="top-bar__label" />
            <uie:ObjectField name="settingsField" allow-scene-objects="false" class="top-bar__field" />
            <ui:Button name="locateButton" text="Locate" tooltip="Ping the active settings asset in the Project window." class="top-bar__button" />
            <ui:Label text="Preview:" class="top-bar__label" tooltip="Edit-Mode locale preview — refreshes every LocalizedText in open scenes and the prefab stage." />
            <ui:DropdownField name="previewLocaleField" />
            <ui:VisualElement class="spacer" />
            <ui:Label name="statusLabel" class="top-bar__status" />
        </ui:VisualElement>

        <!-- Tab bar -->
        <ui:VisualElement name="tabBar" class="tab-bar">
            <ui:Button name="tab-sync"         text="Sync"       class="tab-button tab-button--active" />
            <ui:Button name="tab-tables"       text="Tables"     class="tab-button" />
            <ui:Button name="tab-validation"   text="Validation" class="tab-button" />
        </ui:VisualElement>

        <!-- Content panel — tabs swap their VisualElement into this -->
        <ui:VisualElement name="content" class="content" />

    </ui:VisualElement>
</ui:UXML>
