.root {
    flex-grow: 1;
    flex-direction: column;
}

/* ---------- Top bar ---------- */
.top-bar {
    flex-direction: row;
    align-items: center;
    padding: 6px 8px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
    background-color: var(--unity-colors-toolbar-background);
}

.top-bar__label {
    margin-right: 6px;
    -unity-font-style: bold;
}

.top-bar__field {
    flex-grow: 1;
    min-width: 200px;
    margin-right: 6px;
}

.top-bar__button {
    margin-right: 6px;
    height: 20px;
}

.top-bar__status {
    margin-left: 8px;
    color: var(--unity-colors-default-text);
    -unity-text-align: middle-right;
}

.spacer {
    flex-grow: 1;
}

/* ---------- Tab bar ---------- */
.tab-bar {
    flex-direction: row;
    height: 28px;
    border-bottom-width: 1px;
    border-bottom-color: var(--unity-colors-toolbar-border);
    background-color: var(--unity-colors-toolbar-background);
}

.tab-button {
    background-color: transparent;
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    padding: 0 14px;
    margin: 0;
    -unity-text-align: middle-center;
    color: var(--unity-colors-default-text);
}

.tab-button:hover {
    background-color: var(--unity-colors-button-background-hover);
}

.tab-button--active {
    border-bottom-color: var(--unity-colors-highlight-background);
    -unity-font-style: bold;
}

/* ---------- Content panel ---------- */
.content {
    flex-grow: 1;
}

/* ---------- Empty state ---------- */
.empty-state {
    flex-grow: 1;
    align-items: center;
    justify-content: center;
    padding: 16px;
}

.empty-state__title {
    -unity-font-style: bold;
    font-size: 14px;
    margin-bottom: 8px;
}

.empty-state__hint {
    color: var(--unity-colors-default-text);
    margin-bottom: 12px;
    -unity-text-align: middle-center;
}
